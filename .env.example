# 数据库连接配置（生产按实际填写）
DATABASE_URL="mysql://root:123456@127.0.0.1:3306/wallpaper_community?connect_timeout=10"
DATABASE_USER=root
DATABASE_PASSWORD=123456
DATABASE_NAME=wallpaper_community
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306

# JWT 密钥（生产必须换成随机新值，不要用这套）
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh

# 有效期
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Unsplash API（seed 脚本用，可选）
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
